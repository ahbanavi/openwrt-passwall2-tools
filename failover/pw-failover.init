#!/bin/sh /etc/rc.common
# /etc/init.d/pw-failover — procd service for /root/scripts/pw-failover.sh, the passwall2
# tunnel-node and WAN failover watchdog.
#
# Stopping it leaves the router exactly as it is (an active backup WAN or fallback node stays);
# `/root/scripts/pw-failover.sh revert` puts it back on the primary WAN and node.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /root/scripts/pw-failover.sh run
	# respawn forever, 30 s apart: a crashed watchdog must come back on its own
	procd_set_param respawn 3600 30 0
	procd_set_param stderr 1
	procd_close_instance
}

# LuCI's Save & Apply on /etc/config/pw-failover reloads the service: the daemon re-reads its
# settings at once, without the restart that would reset its startup grace.
service_triggers() {
	procd_add_reload_trigger pw-failover
}

reload_service() {
	/root/scripts/pw-failover.sh reload
}
