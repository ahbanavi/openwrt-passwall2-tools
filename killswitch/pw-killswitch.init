#!/bin/sh /etc/rc.common
# /etc/init.d/pw-killswitch — procd service for /root/scripts/pw-killswitch.sh, the passwall2
# killswitch: the watcher (`run`) and the resolver that answers direct-list names while engaged.
#
# START=18 loads the nft table before the firewall (19) and the network (20), so nothing is
# forwarded at boot before passwall2 is ready.
#
# Stopping the service leaves the gate as it is: a killswitch whose watcher died must stay
# closed, and the next passwall2 restart then holds it engaged. To open it, disable it (LuCI
# Network ▸ Killswitch, or uci pw-killswitch.main.enabled=0 and a reload), which tears it down.

START=18
USE_PROCD=1

SCRIPT=/root/scripts/pw-killswitch.sh
DNSCONF=/etc/pw-killswitch/dns.conf

start_service() {
	if [ "$(uci -q get pw-killswitch.main.enabled)" != 1 ]; then
		/bin/sh "$SCRIPT" teardown
		return 0
	fi
	/bin/sh "$SCRIPT" ensure

	procd_open_instance watch
	procd_set_param command /bin/sh "$SCRIPT" run
	# respawn forever, 5 s apart: until it is back, passwall2's next restart keeps the gate shut
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	if [ -s "$DNSCONF" ]; then
		procd_open_instance dns
		procd_set_param command /usr/sbin/dnsmasq -k -C "$DNSCONF"
		# a recompiled list restarts the resolver on the next reload
		procd_set_param file "$DNSCONF"
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
}

# LuCI's Save & Apply on /etc/config/pw-killswitch reloads the service. Re-running start_service
# lets procd keep the unchanged instances, restart the resolver if its list changed, and drop
# both (after the teardown above) when the killswitch was disabled.
service_triggers() {
	procd_add_reload_trigger pw-killswitch
}

reload_service() {
	start
}
